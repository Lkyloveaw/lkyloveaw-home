{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false
  },
  // ⚠ src/editor 是浏览器端代码（DOM + TipTap），**不进服务端 tsc**：
  //    它由 scripts/build-editor.mjs 用 esbuild 打包，类型检查走 tsconfig.editor.json。
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "content", "src/editor"]
}
