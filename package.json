{
  "name": "personal-wiki",
  "version": "0.1.0",
  "private": true,
  "description": "个人网站：事情分享 + 内网业务系统可用性展示",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "passwd": "node dist/cli/passwd.js",
    "check:unit": "npm run build && node scripts/unit-check.mjs",
    "check:media": "npm run build && node scripts/media-check.mjs",
    "check:leak": "npm run build && node scripts/leak-check.mjs",
    "check:chart": "npm run build && node scripts/chart-check.mjs && node scripts/panel-check.mjs",
    "check:backup": "npm run build && node scripts/backup-check.mjs && node scripts/probe-integration-check.mjs",
    "check:restart": "npm run build && node scripts/restart-check.mjs",
    "check:e2e": "node scripts/e2e-check.mjs",
    "check:docker": "node scripts/check-docker-context.mjs",
    "check:all": "npm run verify && npm run check:e2e",
    "verify": "npm run typecheck && npm run check:docker && npm run check:unit && npm run check:media && npm run check:article && npm run check:leak && npm run check:chart && npm run check:backup && npm run check:restart",
    "check:article": "npm run build && node scripts/article-pipeline-check.mjs",
    "articles": "node dist/cli/articles.js"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.6",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.2",
    "prosemirror-model": "^1.25.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
