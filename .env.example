# 服务监听
PORT=3000
HOST=0.0.0.0

# SQLite 数据文件位置（Docker 里挂 volume 到 /app/data）
DATABASE_PATH=./data/availability.sqlite

# 站点信息
# ⚠ 这三项**只作为首次启动的初始值**：首次启动会把当前生效值落进数据库，
# 之后真源是 SQLite，改这里不再有任何效果（值不同时启动日志里会有一行警告）。
# 要改请登录后在 管理台 → 站点设置 里改。
SITE_TITLE=我的个人站
SITE_DESCRIPTION=事情分享，以及内网各业务系统的可用性

# 探测：目标清单。⚠ **只在首次启动、targets 表为空时导入一次**；之后真源是数据库，
# 改这个文件不再有任何效果（要增删改目标请登录后在 管理台 → 目标 里改）。
TARGETS_PATH=./targets.json
# 也可以直接给一份 JSON 数组（它优先于文件，适合 Docker 部署）——同样**只用于首次导入**。
# TARGETS_JSON=[{"id":"wiki","name":"知识库","url":"http://10.0.0.10/","group":"办公"}]

# 探测：轮询间隔（秒）与单次请求超时（毫秒）
# ⚠ 轮询间隔同上：**只作为首次启动的初始值**，之后真源是数据库（管理台 → 站点设置），
#   改完下一轮生效、不打断正在等的那一轮。
#    单次请求超时**留在 .env**：它决定单次探测的成败判定，改错会让全站误报。
PROBE_INTERVAL_SECONDS=60
PROBE_TIMEOUT_MS=5000

# 历史保留天数（超期自动清理）
PROBE_RETENTION_DAYS=30

# ─────────────────────────────────────────────────────────────
# 媒体（文章配图的上传目录）
# ─────────────────────────────────────────────────────────────
# 与数据库同在 data/ 下，Docker 里同一个 volume 就够；不要指到临时目录（重启即丢）。
MEDIA_DIR=./data/media

# ─────────────────────────────────────────────────────────────
# 备份
# ─────────────────────────────────────────────────────────────
# 备份目录。默认与数据库同目录（同一个 volume），Docker 与裸机都不需要额外挂载。
# ⚠ 备份**只用 SQLite 在线备份 API**，绝不要 `cp` 数据库文件——只拷 .sqlite 得到的是空库。
BACKUP_DIR=./data/backups

# 滚动保留几份（按日期命名，同一天只留一份）。实测产物约等于主库大小，不压缩。
BACKUP_KEEP=7

# 每几轮探测做一次 checkpoint / 备份（默认 60 轮 ≈ 1 小时）。
# 绑探测轮次而不是另开定时器：探测轮次已经是这个进程唯一的心跳。
# 设为 0 可关闭对应动作。
CHECKPOINT_EVERY_ROUNDS=60
BACKUP_EVERY_ROUNDS=60

# ─────────────────────────────────────────────────────────────
# 登录与会话
# ─────────────────────────────────────────────────────────────

# ⚠ 必填，没配会**拒绝启动**。会话 cookie 用它与 HMAC 签名。
# 生成一个（≥32 字节随机）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 注意：换掉它会**让所有人立刻掉线**；反过来，不配就自动生成也会导致每次重启全员掉线，
# 所以这里选择「拒绝启动」——失败要显眼，不要静默降级。
SESSION_SECRET=

# 会话存活时间（秒），默认 7 天。
SESSION_TTL_SECONDS=604800

# cookie 的 Secure 属性开关：1 开 / 0 关，**默认 0（关）**。
# ⚠ 站点还是 HTTP 时千万不要开：浏览器不会保存带 Secure 的 cookie，
#   表现为「输对密码又跳回登录页」，很难排查。上了 HTTPS 之后再改成 1。
SESSION_COOKIE_SECURE=0

# ⚠ 必填，没配会**拒绝启动**。写路径的来源校验（L2）靠它 fail-closed：
# 所有非安全方法（POST / PUT / PATCH / DELETE）的 Origin 必须**精确等于**这里的一条，
# 或者 Referer 的 origin 等于其中一条；两者都拿不到 → 403。
# 写**浏览器地址栏里那个 origin**（协议 + 主机 + 端口，**不带路径、不带结尾斜杠**）。
# 多个来源用逗号分隔（例如同时用 IP 与域名访问）。
# ⚠ 端口属于 origin：http://10.0.0.226:3000 ≠ http://10.0.0.226
SITE_ORIGIN=http://10.0.0.226:3000

# 反向代理信任开关，**默认关**（不写这一项就是不信任任何代理）。
# ⚠ **不许填 true** —— 会拒绝启动：打开它之后 X-Forwarded-* 可被任意直连客户端伪造。
# 要信任反向代理就填**具体的** CIDR（逗号分隔）：
# TRUST_PROXY=127.0.0.1,10.0.0.0/8
TRUST_PROXY=

# 首个账号：**只在 users 表为空时生效**。
# 表里一旦有任何账号，这两个变量被完全忽略——否则一个残留的环境变量
# 就是一个隐藏的后门账号（环境变量会长期留在 compose 文件与 shell 历史里）。
# 日常改密请用网页，忘记口令用 CLI 救援：
#   node dist/cli/passwd.js --user <名字> --password <新口令>
#   node dist/cli/passwd.js --user <名字> --revoke-sessions   # 只踢会话，不改口令
ADMIN_USERNAME=
ADMIN_PASSWORD=
